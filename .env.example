# 本项目主要使用 config.php，不强制使用 .env。
# 如自行接入环境变量，仅填写占位符，切勿提交真实密钥。

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=ds_shop
DB_PREFIX=shua

# 支付 / 短信 / 邮件 / AI 均在后台设置中配置，仓库内不要存放真实凭据。
PAYMENT_PID=CHANGE_ME
PAYMENT_KEY=CHANGE_ME
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
AI_API_KEY=CHANGE_ME
